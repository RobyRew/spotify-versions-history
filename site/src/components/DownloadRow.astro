---
import { orderedSources, originPills, sourceNote, isExpired, formatSize, platformNames, permalink } from '../lib/catalog.mjs';
const { entry } = Astro.props;
const ordered = orderedSources(entry);
const source = ordered.find(candidate => !isExpired(candidate)) ?? ordered[0];
const others = ordered.filter(candidate => candidate !== source);
const pills = originPills(entry);
const counted = Astro.site?.hostname === 'spotify-versions-history.robyrew.com';
const downloadHref = counted ? permalink(entry.fullVersion, entry.platform, entry.architecture) : source?.url;
const base = import.meta.env.BASE_URL;
const pill = (item, label) => {
  if (!item) return { label, className: 'pill is-missing', href: null, note: 'No link on record' };
  const down = isExpired(item);
  return { label, className: down ? 'pill is-down' : 'pill', href: down ? null : item.url, note: sourceNote(item) };
};
const columns = [pill(pills.spotify, 'Spotify'), pill(pills.archive, 'Archive'), pill(pills.mirror, 'amd64fox')];
---
<tr data-id={entry.id}>
  <td>
    <a class="ver" href={`${base}release/?id=${encodeURIComponent(entry.id)}`}>{entry.version}</a>
    <small class="hash">{entry.fullVersion.split('.').at(-1)}</small>
  </td>
  <td><span class="platform-label">{platformNames[entry.platform] ?? entry.platform}</span><small>{entry.architecture} · {entry.format.toUpperCase()}</small></td>
  <td><time datetime={entry.date ?? undefined}>{entry.date ?? 'Not listed'}</time><small>{formatSize(entry.size)}</small></td>
  <td>
    <span class="pills">
      {columns.map(column => column.href
        ? <a class={column.className} href={column.href} title={column.note}><i></i>{column.label}</a>
        : <span class={column.className} title={column.note}><i></i>{column.label}</span>)}
    </span>
  </td>
  <td class="counts"><span data-likes>{entry.likes ?? 0}</span> likes · <span data-comments>{entry.comments ?? 0}</span></td>
  <td class="row-action">{!source || isExpired(source)
    ? <span class="download-link expired" title={source ? sourceNote(source) : 'No download'}>No download</span>
    : <a class="download-link" href={downloadHref} title={entry.sha256 ? `SHA-256 ${entry.sha256}` : undefined} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${source.label}`}>Download</a>}{others.some(other => !isExpired(other)) && <small class="alt-links">also: {others.filter(other => !isExpired(other)).map(other => <a href={other.url} title={sourceNote(other)} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${other.label}`}>{other.label}</a>)}</small>}{others.filter(other => isExpired(other)).map(other => <small class="official-path" title={sourceNote(other)}><span class="expired-label">{other.label} · expired</span><code>{other.url}</code></small>)}</td>
</tr>
