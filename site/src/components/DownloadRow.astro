---
import { orderedSources, sourceNote, isExpired, formatSize, platformNames } from '../lib/catalog.mjs';
const { entry } = Astro.props;
const ordered = orderedSources(entry);
const source = ordered.find(candidate => !isExpired(candidate)) ?? ordered[0];
const others = ordered.filter(candidate => candidate !== source);
---
<tr>
  <td><strong>{entry.version}</strong><small class="hash">{entry.fullVersion.split('.').at(-1)}</small></td>
  <td><span class="platform-label">{platformNames[entry.platform]}</span><small>{entry.architecture} · {entry.format.toUpperCase()}</small></td>
  <td><time datetime={entry.date ?? undefined}>{entry.date ?? 'Not listed'}</time><small>{formatSize(entry.size)}</small></td>
  <td><span class:list={['source-label', source.kind]}>{source.label}</span><small>{sourceNote(source)}</small></td>
  <td class="row-action">{isExpired(source)
    ? <span class="download-link expired" title={sourceNote(source)}>No download</span>
    : <a class="download-link" href={source.url} title={entry.sha256 ? `SHA-256 ${entry.sha256}` : undefined} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${source.label}`}>Download <span aria-hidden="true">↗</span></a>}{others.some(other => !isExpired(other)) && <small class="alt-links">also: {others.filter(other => !isExpired(other)).map(other => <a href={other.url} title={sourceNote(other)} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${other.label}`}>{other.label}</a>)}</small>}{others.filter(other => isExpired(other)).map(other => <small class="official-path" title={sourceNote(other)}><span class="expired-label">{other.label} · expired</span><code>{other.url}</code></small>)}</td>
</tr>
