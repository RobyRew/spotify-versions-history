---
import snapshot from '../../data/catalog.json';
import official from '../../data/official.json';
import { applyOfficial, filterCatalog } from '../lib/catalog.mjs';
import DownloadRow from '../components/DownloadRow.astro';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const catalog = { ...snapshot, entries: applyOfficial(snapshot.entries, official) };
const entries = filterCatalog(catalog.entries, { platform: 'windows' });
const versions = new Set(catalog.entries.map(entry => entry.version)).size;
const current = official.builds.find(build => build.architecture === 'x64' && build.etag === official.watched['windows-x64']?.etag);
const platforms = [
  ['all', 'All'], ['windows', 'Windows'], ['windows-store', 'Store'], ['macos', 'macOS'],
  ['linux', 'Linux'], ['android', 'Android'], ['ios', 'iOS'],
];
const sorts = [['newest', 'Newest'], ['downloads', 'Downloads'], ['likes', 'Liked'], ['oldest', 'Oldest']];
---
<Base title="Spotify versions" description="Official Spotify installers for Windows, macOS and Linux, with version records for the Microsoft Store, Android and iOS." page="library">
  <section class="page-head">
    <p class="eyebrow">Official builds</p>
    <h1>Every Spotify version we can still point at.</h1>
    <p class="lead">{versions.toLocaleString('en-US')} versions. Newest first. Downloads, likes and comments live on the signed-in site.</p>
  </section>

  <section class="latest" aria-label="Latest official downloads">
    <a class="rw-btn rw-btn--primary" data-official-download href="https://download.scdn.co/SpotifyFullSetupX64.exe">Windows x64</a>
    <a class="rw-btn" data-official-download href="https://download.scdn.co/Spotify.dmg">Mac Intel</a>
    <a class="rw-btn" data-official-download href="https://download.scdn.co/SpotifyARM64.dmg">Mac Apple silicon</a>
    <a class="rw-btn" href="https://www.spotify.com/download/linux/">Linux</a>
    <p>{current ? <>Windows x64 is <strong>{current.fullVersion}</strong>.</> : 'Current builds, from Spotify.'}</p>
  </section>

  <section id="catalog" data-api={`${base}api/v1/catalog.json`} data-base={base}>
    <div class="filters">
      <div class="seg-scroll">
        <div class="rw-seg" id="platform-seg" role="radiogroup" aria-label="Platform" data-rw-seg="select">
          <span class="rw-seg__thumb" aria-hidden="true"></span>
          {platforms.map(([value, label]) => <button type="button" class="rw-seg__item" role="radio" data-platform={value} data-value={value} aria-checked={value === 'windows' ? 'true' : 'false'}>{label}</button>)}
        </div>
      </div>
      <div class="filter-row">
        <label class="search">Search<input id="search" class="rw-field" type="search" placeholder="Version or build" aria-label="Search Spotify versions" autocomplete="off" /></label>
        <label>Architecture<select id="architecture" class="rw-field"><option value="all">All architectures</option><option value="x64">x64 / Intel</option><option value="arm64">ARM64</option><option value="x86">x86</option></select></label>
        <label>Source<select id="source" class="rw-field"><option value="all">All sources</option><option value="official">Official Spotify only</option><option value="archive">Archive copies</option><option value="mirror">amd64fox mirrors</option></select></label>
        <div class="rw-seg" id="sort-seg" role="radiogroup" aria-label="Sort" data-rw-seg="select">
          <span class="rw-seg__thumb" aria-hidden="true"></span>
          {sorts.map(([value, label]) => <button type="button" class="rw-seg__item" role="radio" data-value={value} aria-checked={value === 'newest' ? 'true' : 'false'}>{label}</button>)}
        </div>
        <button id="reset" class="rw-btn" type="button">Reset</button>
      </div>
    </div>
    <div class="results-heading">
      <p id="result-count" role="status" aria-live="polite">{entries.length} installers for Windows</p>
    </div>
    <p class="notice">Older official CDN links may have expired. Each row shows Spotify, this archive, and amd64fox. A red pill is a link that no longer downloads. iPadOS uses the iOS app.</p>
    <p id="load-error" class="notice" hidden>Could not load the full library. The first results are shown below. <button id="retry" class="rw-btn" type="button">Try again</button></p>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Spotify installers</caption>
        <thead><tr><th>Version</th><th>Platform</th><th>Released</th><th>Origins</th><th>Likes</th><th><span class="sr-only">Download</span></th></tr></thead>
        <tbody id="results">{entries.slice(0, 30).map(entry => <DownloadRow entry={entry} />)}</tbody>
      </table>
      <div id="empty" class="empty" hidden>
        <h3>No builds match</h3>
        <p>Store, Android and iOS rows appear when that sensor has a version. They do not carry an installer until Spotify publishes one.</p>
        <button id="empty-reset" class="rw-btn" type="button">Clear filters</button>
      </div>
    </div>
    <div class="pager">
      <span id="page-label">Showing 1–30</span>
      <div>
        <button id="previous" class="rw-btn" type="button" disabled>Previous</button>
        <button id="next" class="rw-btn" type="button">Next</button>
      </div>
    </div>
  </section>
  <script src="../lib/browser.mjs"></script>
</Base>
