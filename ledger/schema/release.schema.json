{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 2
    },
    "product": {
      "type": "string",
      "enum": [
        "desktop",
        "android",
        "ios"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,5}(\\.\\d{1,8}){1,3}$"
    },
    "fullVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "windows",
              "macos",
              "linux",
              "windows-store",
              "android",
              "ios"
            ]
          },
          "arch": {
            "type": "string",
            "enum": [
              "x64",
              "arm64",
              "x86",
              "universal"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "exe",
              "tbz",
              "dmg",
              "zip",
              "deb",
              "snap",
              "msix",
              "msixbundle",
              "appx",
              "appxbundle",
              "apk",
              "apks"
            ]
          },
          "listing": {
            "type": "object",
            "properties": {
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "official",
                        "archive",
                        "mirror"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "url",
                    "kind",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "date",
              "size",
              "sources"
            ],
            "additionalProperties": false
          },
          "captures": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "sha1": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{40}$"
                },
                "size": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "lastModified": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "capturedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "etag": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sensors": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "exe",
                    "tbz",
                    "dmg",
                    "zip",
                    "deb",
                    "snap",
                    "msix",
                    "msixbundle",
                    "appx",
                    "appxbundle",
                    "apk",
                    "apks"
                  ]
                },
                "verified": {
                  "type": "string",
                  "const": "binary_hash"
                },
                "conflict": {
                  "type": "string"
                },
                "updateService": {
                  "type": "object",
                  "properties": {
                    "httpPrefix": {
                      "type": "string",
                      "format": "uri"
                    },
                    "binaryHash": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-fA-F]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "targetVersion": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "seenAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "signedUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "signedUntil": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "httpPrefix",
                    "seenAt"
                  ],
                  "additionalProperties": false
                },
                "archive": {
                  "type": "string",
                  "format": "uri"
                },
                "archivedFrom": {
                  "type": "string"
                }
              },
              "required": [
                "sha256",
                "capturedAt",
                "url",
                "sensors"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "platform",
          "arch",
          "format"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "product",
    "version",
    "fullVersion",
    "artifacts"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/RobyRew/spotify-versions-history/blob/main/ledger/schema/release.schema.json",
  "title": "Spotify versions archive: one release",
  "description": "A release and its artifacts. `listing` is what an upstream catalog said; `captures` is what this repository downloaded and hashed. Cross-field rules (artifact ids, version agreement) are enforced by lib/ledger/schema.ts."
}
