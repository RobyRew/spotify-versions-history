{
  "name": "spotify-versions-history-web",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.0",
  "description": "The archive's website and API: every official Spotify build, its download links and how each was verified.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build",
    "preview": "node ./dist/server/entry.mjs",
    "check": "astro sync && tsc --noEmit && node scripts/astro-check.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.3",
    "@robyrew/web-config": "github:RobyRew/web-config#v0.5.0-rc.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3"
  }
}
