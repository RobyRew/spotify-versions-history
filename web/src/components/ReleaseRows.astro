---
/**
 * Rows of the releases table. The versions page's Load more fetches the next page and appends its
 * rows to the same tbody, so the rows carry everything they show.
 */
import Icon from '@robyrew/ui/components/Icon.astro';
import type { ReleaseView } from '../../../lib/site/model.ts';
import { formatDate } from '../lib/format.ts';
import PlatformLabel from './PlatformLabel.astro';

interface Props {
  releases: readonly ReleaseView[];
}

const { releases } = Astro.props;
---

{
  releases.map(release => (
    <tr>
      <td data-label="Version">
        <a class="release-link" href={`/v/${release.product}/${release.version}`}>
          <span class="mono">{release.version}</span>
          <small class="mono">{release.fullVersion.slice(release.version.length + 1)}</small>
        </a>
      </td>
      <td data-label="Released">{formatDate(release.date)}</td>
      <td data-label="Platforms">
        <span class="release-platforms">
          {release.platforms.map(platform => <PlatformLabel platform={platform} compact />)}
        </span>
      </td>
      <td data-label="Checked">
        {release.signed ? (
          <span class="rw-badge rw-badge--ok"><Icon name="shield" size={13} />Signed</span>
        ) : (
          <span class="release-quiet">—</span>
        )}
      </td>
      <td data-label="Links" class="is-num">
        {release.downloadable ? (
          <span>{release.artifacts.filter(artifact => artifact.best).length} of {release.artifacts.length}</span>
        ) : (
          <span class="release-quiet">none live</span>
        )}
      </td>
    </tr>
  ))
}

<style>
  .release-link {
    display: inline-flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .release-link:hover {
    color: var(--accent);
  }
  .release-link small {
    color: var(--ink-3);
    font-weight: 400;
    font-size: 0.78rem;
  }
  .release-platforms {
    display: inline-flex;
    gap: 0.55rem;
  }
  .release-quiet {
    color: var(--ink-3);
  }
</style>
