---
/**
 * The home page, in the order people come for: the build for their system, every platform's newest
 * build, what the community likes and says, then the newest releases. The archive's own numbers are
 * one quiet line under the hero; the details live on /probes, /about and /api.
 */
import Avatar from '@robyrew/ui/components/Avatar.astro';
import Icon from '@robyrew/ui/components/Icon.astro';
import StatusDot from '@robyrew/ui/components/StatusDot.astro';
import { fallbackHandle } from '@robyrew/astro-logto/handle';
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import PlatformCard from '../components/PlatformCard.astro';
import ReleaseItems from '../components/ReleaseItems.astro';
import { ARCH_LABELS, findRelease, latestDownloads, PLATFORM_LABELS, type Platform } from '../../../lib/site/model.ts';
import { releaseKey } from '../../../lib/site/social.ts';
import { community, releaseCounts } from '../lib/community.ts';
import { siteData } from '../lib/data.ts';
import { deviceFromHeaders } from '../lib/device.ts';
import { formatBytes, formatDate, formatDateTime } from '../lib/format.ts';

const data = await siteData();
const latest = latestDownloads(data.releases);
const newest = data.releases[0] ?? null;
const recent = data.releases.slice(0, 6);
const device = deviceFromHeaders(Astro.request.headers);
const counts = releaseCounts('all');

const DESKTOP: readonly Platform[] = ['windows', 'macos', 'linux'];
const cards = DESKTOP.map(platform => ({
  platform,
  entries: latest.filter(entry => entry.platform === platform),
  releases: data.releases.filter(release => release.platforms.includes(platform)).length,
})).filter(card => card.entries.length > 0);

// The hero's download: the visitor's system and architecture, else that system's first build.
const mine = device ? (latest.find(entry => entry.platform === device.platform && entry.arch === device.arch) ?? latest.find(entry => entry.platform === device.platform) ?? null) : null;

// The one status line.
const verified = data.verification?.artifacts ?? [];
const signed = verified.filter(artifact => artifact.ok && artifact.level === 'signed').length;
const notOk = verified.filter(artifact => !artifact.ok).length;
const probedAt = data.health?.generatedAt ?? data.verification?.generatedAt ?? null;

const mobile = data.mobile as { ios?: { version?: string; releaseDate?: string; listing?: string }; windowsStore?: { lastUpdate?: string; listing?: string } } | null;
// Phones and tablets link to /mobile, which keeps their history and the store links.
const iosNow = data.mobileHistory?.ios.versions[0] ?? null;
const androidNow = data.mobileHistory?.android.updates[0] ?? null;
const stores = [
  {
    name: 'iPhone and iPad', icon: 'apple' as const, href: '/mobile#ios',
    detail: iosNow ? `App Store · ${iosNow.version} · ${formatDate(iosNow.releasedAt)} · ${data.mobileHistory!.ios.versions.length} versions recorded` : `App Store${mobile?.ios?.version ? ` · ${mobile.ios.version}` : ''}`,
  },
  {
    name: 'Android', icon: 'android' as const, href: '/mobile#android',
    detail: androidNow ? `Google Play · updated ${formatDate(androidNow.updatedAt)}${androidNow.reportedVersion ? ` · reviewers report ${androidNow.reportedVersion}` : ''}` : 'Google Play',
  },
];
const msStore = { date: mobile?.windowsStore?.lastUpdate ?? null, href: mobile?.windowsStore?.listing ?? 'https://apps.microsoft.com/detail/9ncbcszsjrsb' };

// Community: the most liked releases this week (all time when the week has none), and the newest comments.
const weekly = releaseCounts('week');
const byLikes = (source: typeof counts) => data.releases
  .map(release => ({ release, likes: source.get(releaseKey(release))?.likes ?? 0, comments: counts.get(releaseKey(release))?.comments ?? 0 }))
  .filter(item => item.likes > 0)
  .sort((a, b) => b.likes - a.likes)
  .slice(0, 5);
const weekTop = byLikes(weekly);
const topLiked = weekTop.length > 0 ? weekTop : byLikes(counts);
const topPeriod = weekTop.length > 0 ? 'week' : 'all';
const latestComments = community().store.recentComments(5).map(comment => ({
  ...comment,
  releaseView: findRelease(data.releases, comment.release.split('/')[0] ?? '', comment.release.split('/')[1] ?? ''),
  snippet: comment.body.length > 160 ? `${comment.body.slice(0, 157).trimEnd()}…` : comment.body,
}));
const quiet = topLiked.length === 0 && latestComments.length === 0;
const AGO = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
const ago = (ms: number) => {
  const minutes = Math.round((ms - Date.now()) / 60_000);
  if (Math.abs(minutes) < 60) return AGO.format(minutes, 'minute');
  const hours = Math.round(minutes / 60);
  return Math.abs(hours) < 48 ? AGO.format(hours, 'hour') : AGO.format(Math.round(hours / 24), 'day');
};
---

<Base section="home">
  <section class="hero" aria-labelledby="hero-title">
    <p class="pill" data-hero><Icon name="shield" size={14} /> Official, unmodified builds only</p>
    <h1 id="hero-title" class="hero__title" data-hero>Every official Spotify build, <span class="hero__accent">in one place.</span></h1>
    <p class="hero__lead" data-hero>Spotify’s own installers for every system, kept build by build, each file marked with whether its signature was checked.</p>
    <div class="hero__ctas" data-hero>
      {mine && <DownloadButton artifact={mine.artifact} version={mine.release.version} size="lg" label={`Download for ${PLATFORM_LABELS[mine.platform]}`} />}
      <a class:list={['rw-btn', 'rw-btn--lg', { 'rw-btn--primary': !mine }]} href="/versions"><Icon name="history" size={18} />Browse {data.releases.length} versions</a>
    </div>
    {
      mine && (
        <p class="hero__for" data-hero>
          <span class="mono">{mine.release.version}</span> · {ARCH_LABELS[mine.arch]} · {formatBytes(mine.artifact.size)}. Not your system? <a href="#latest">Every platform</a>
        </p>
      )
    }
    <a class="status" href="/probes" data-hero>
      <StatusDot status={!data.verification && !data.health ? 'unknown' : notOk ? 'danger' : 'ok'} hideLabel />
      <span>
        {data.verification ? `${signed} of ${verified.length} current builds signed` : 'No verification report yet'}
        {probedAt && <span class="status__when"> · probes ran {formatDateTime(probedAt)}</span>}
      </span>
      <Icon name="arrowRight" size={14} />
    </a>
  </section>

  <div class="section-head" id="latest"><h2>Download</h2><a href="/versions">All versions</a></div>
  <div class="cards">
    {
      cards.map(card => (
        <PlatformCard platform={card.platform} entries={card.entries} device={device} releases={card.releases} counts={counts}>
          {card.platform === 'windows' && (
            <a slot="extra" class="pstore" href={msStore.href} rel="noopener">
              <span class="pstore__mark" aria-hidden="true"><Icon name="store" size={18} /></span>
              <span class="pstore__text">
                <strong>Also in the Microsoft Store</strong>
                <span>{msStore.date ? `Updated ${formatDate(msStore.date)} · ` : ''}the Store’s own packages are checked daily</span>
              </span>
              <Icon name="external" size={15} />
            </a>
          )}
        </PlatformCard>
      ))
    }
  </div>
  <div class="stores">
    {
      stores.map(store => (
        <a class="rw-card rw-card--interactive store reveal" href={store.href}>
          <span class="store__mark" aria-hidden="true"><Icon name={store.icon} size={20} /></span>
          <span class="store__text">
            <strong>{store.name}</strong>
            <span>{store.detail}</span>
          </span>
          <Icon name="chevronRight" size={16} />
        </a>
      ))
    }
  </div>

  <div class="section-head" id="community"><h2>Community</h2><a href="/versions?sort=active">Recently active</a></div>
  {
    quiet ? (
      <div class="rw-card invite reveal">
        <span class="invite__mark" aria-hidden="true"><Icon name="message" size={22} /></span>
        <div>
          <p class="invite__title">No likes or comments yet</p>
          <p class="invite__text">Tell others whether a build starts, signs in and plays: open a release, like it, react or leave a note.</p>
        </div>
        {newest && <a class="rw-btn rw-btn--primary" href={`/v/${newest.product}/${newest.version}#community`}>Open the newest build</a>}
      </div>
    ) : (
      <div class="social">
        <section class="rw-card social__col reveal" aria-labelledby="top-liked">
          <header class="social__head">
            <h3 id="top-liked"><Icon name="heart" size={16} />Most liked {topPeriod === 'week' ? 'this week' : ''}</h3>
            <a href={`/versions?sort=liked${topPeriod === 'week' ? '&period=week' : ''}`}>See all</a>
          </header>
          {topLiked.length === 0 ? (
            <p class="social__empty">No likes yet.</p>
          ) : (
            <ol class="top">
              {topLiked.map((item, index) => (
                <li>
                  <span class="top__rank">{index + 1}</span>
                  <a class="top__version mono" href={`/v/${item.release.product}/${item.release.version}#community`}>{item.release.version}</a>
                  <span class="top__date">{formatDate(item.release.date)}</span>
                  <span class="top__counts"><Icon name="heart" size={13} />{item.likes}<Icon name="message" size={13} />{item.comments}</span>
                </li>
              ))}
            </ol>
          )}
        </section>
        <section class="rw-card social__col reveal" aria-labelledby="latest-comments">
          <header class="social__head">
            <h3 id="latest-comments"><Icon name="message" size={16} />Latest comments</h3>
            <a href="/versions?sort=active">All activity</a>
          </header>
          {latestComments.length === 0 ? (
            <p class="social__empty">No comments yet.</p>
          ) : (
            <ol class="said">
              {latestComments.map(comment => {
                const handle = comment.author.deleted ? 'deleted' : (comment.author.handle ?? fallbackHandle(comment.author.id));
                return (
                  <li>
                    <Avatar name={comment.author.name ?? handle} src={comment.author.avatar} size="sm" />
                    <div class="said__main">
                      <p class="said__head">
                        <strong>{comment.author.deleted ? 'Deleted account' : `@${handle}`}</strong>
                        <span>on <a class="mono" href={`/v/${comment.release}#c-${comment.id}`}>{comment.releaseView?.version ?? comment.release.split('/')[1]}</a></span>
                        <time datetime={new Date(comment.createdAt).toISOString()}>{ago(comment.createdAt)}</time>
                      </p>
                      <p class="said__text">{comment.snippet}</p>
                    </div>
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      </div>
    )
  }

  <div class="section-head"><h2>Recent releases</h2><a href="/versions">All {data.releases.length}</a></div>
  <ol class="rw-card rl-list reveal" aria-label="Recent releases">
    <ReleaseItems releases={recent} latest={newest?.version} counts={counts} />
  </ol>
</Base>

<script>
  import { heroIn, revealOnScroll } from '../scripts/motion.ts';
  heroIn();
  revealOnScroll('.reveal');
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.95rem;
    padding: clamp(1rem, 3vw, 2.4rem) 0 0.25rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.34rem 0.8rem;
    border: 1px solid var(--hair);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 650;
  }
  .pill :global(svg) {
    color: var(--accent);
  }
  .hero__title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.1rem, 1.2rem + 3.4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hero__accent {
    color: var(--accent);
  }
  .hero__lead {
    max-width: 40rem;
    margin: 0;
    color: var(--ink-2);
    font-size: clamp(1rem, 0.6vw + 0.85rem, 1.12rem);
    line-height: 1.55;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.2rem;
  }
  .hero__for {
    margin: -0.35rem 0 0;
    color: var(--ink-3);
    font-size: 0.86rem;
  }
  .hero__for a {
    color: var(--ink-2);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-3);
    font-size: 0.84rem;
    text-decoration: none;
  }
  .status:hover {
    color: var(--accent);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.9rem;
  }
  /* With all three systems: Windows (three builds) runs down the left, macOS and Linux stack on the right. */
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards > :global(#windows:first-child:nth-last-child(3)) {
      grid-row: span 2;
    }
  }
  .pstore {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: auto 1.1rem 0.9rem;
    padding: 0.75rem 0.9rem;
    border: 1px dashed var(--hair);
    border-radius: var(--rw-r-ctl);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .pstore + :global(.pcard__all) {
    margin-top: 0;
  }
  .pstore:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--hair));
    background: var(--rw-fill);
  }
  .pstore__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: var(--rw-fill);
  }
  .pstore__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    font-size: 0.9rem;
  }
  .pstore__text span {
    color: var(--ink-3);
    font-size: 0.8rem;
  }
  .stores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.9rem;
    margin-top: 0.9rem;
  }
  .store {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .store__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.75rem;
    background: var(--rw-fill);
  }
  .store__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    font-size: 0.92rem;
  }
  .store__text span {
    color: var(--ink-3);
    font-size: 0.84rem;
  }

  .invite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.2rem;
    padding: 1.1rem 1.2rem;
  }
  .invite > div {
    flex: 1 1 18rem;
  }
  .invite__mark {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.9rem;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .invite__title {
    margin: 0;
    font-weight: 650;
  }
  .invite__text {
    margin: 0.2rem 0 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .social {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0.9rem;
  }
  .social__col {
    padding: 0.4rem 0 0.6rem;
  }
  .social__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1.1rem 0.5rem;
  }
  .social__head h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.98rem;
    font-weight: 650;
  }
  .social__head h3 :global(svg) {
    color: var(--accent);
  }
  .social__head a {
    color: var(--ink-2);
    font-size: 0.86rem;
    text-decoration: none;
  }
  .social__head a:hover {
    color: var(--accent);
  }
  .social__empty {
    margin: 0;
    padding: 0.5rem 1.1rem 0.6rem;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
  .top,
  .said {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .top li {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 1.1rem;
    border-top: 1px solid var(--hair-soft);
  }
  .top__rank {
    color: var(--ink-3);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .top__version {
    color: var(--ink);
    font-weight: 650;
    text-decoration: none;
  }
  .top__version:hover {
    color: var(--accent);
  }
  .top__date {
    color: var(--ink-3);
    font-size: 0.82rem;
  }
  .top__counts {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-2);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }
  .top__counts :global(svg:nth-of-type(2)) {
    margin-left: 0.5rem;
  }
  .said li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.65rem 1.1rem;
    border-top: 1px solid var(--hair-soft);
  }
  .said__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    margin: 0;
    font-size: 0.86rem;
  }
  .said__head span,
  .said__head time {
    color: var(--ink-3);
  }
  .said__head a {
    color: var(--ink-2);
  }
  .said__text {
    margin: 0.2rem 0 0;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
</style>
