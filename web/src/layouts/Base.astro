---
import Avatar from '@robyrew/ui/components/Avatar.astro';
import Icon from '@robyrew/ui/components/Icon.astro';
import SiteHeader from '@robyrew/ui/components/SiteHeader.astro';
import { themeBootstrap } from '@robyrew/web-config/theme-bootstrap';
import { community, ID_SITE, signInHref, viewerOf, type SiteUser } from '../lib/community.ts';
import '../styles/global.css';

type Section = 'home' | 'versions' | 'mobile' | 'probes' | 'api' | 'about' | 'release' | 'admin';

interface Props {
  title?: string;
  description?: string;
  section: Section;
  /** Keep the page out of search engines. */
  noindex?: boolean;
  /** The signed-in person when the page already looked them up; otherwise the layout does. */
  viewer?: SiteUser | null;
}

const {
  title,
  description = 'Every official Spotify client build, with its download links and whether each file was checked against its publisher’s signature.',
  section,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · Spotify Versions` : 'Spotify Versions — every official Spotify build';
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { label: 'Versions', href: '/versions', current: section === 'versions' || section === 'release', icon: 'history' as const },
  { label: 'Mobile', href: '/mobile', current: section === 'mobile', icon: 'phone' as const },
  { label: 'Probes', href: '/probes', current: section === 'probes', icon: 'activity' as const },
  { label: 'API', href: '/api', current: section === 'api', icon: 'braces' as const },
  { label: 'About', href: '/about', current: section === 'about', icon: 'info' as const },
];
const year = new Date().getUTCFullYear();
const signInEnabled = community().auth !== null;
const viewer = Astro.props.viewer !== undefined ? Astro.props.viewer : signInEnabled ? await viewerOf(Astro.request) : null;
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f2f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090909" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/json" title="API v2: releases" href="/api/v2/releases" />
    <!-- House pre-paint theme stamp; its CSP hash is computed in astro.config.mjs. -->
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body data-section={section}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader
      name="Spotify Versions"
      sub="archive"
      mark="history"
      links={links}
      actions={[{ label: 'Source', href: 'https://github.com/RobyRew/spotify-versions-history', icon: 'code' }]}
    >
      {
        signInEnabled && (
          <div slot="account" class="account">
            {viewer ? (
              <>
                <a class="account__me" href={ID_SITE} title={`Signed in as @${viewer.handle}: your RobyRew ID`}>
                  <Avatar name={viewer.name ?? viewer.handle} src={viewer.avatar} size="sm" />
                  <span class="account__handle">@{viewer.handle}</span>
                </a>
                <form class="account__out" method="post" action="/api/auth/sign-out">
                  <button class="rw-btn rw-btn--icon rw-btn--sm" type="submit" aria-label="Sign out" title="Sign out"><Icon name="logOut" size={16} /></button>
                </form>
              </>
            ) : (
              <a class="rw-btn rw-btn--sm" href={signInHref(returnTo)}><Icon name="logIn" size={16} />Sign in</a>
            )}
          </div>
        )
      }
    </SiteHeader>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__about">
          <p class="site-footer__name"><span aria-hidden="true"><Icon name="history" size={15} /></span>Spotify Versions</p>
          <p>
            Not affiliated with or endorsed by Spotify. The archive lists Spotify’s own, unmodified builds only, served
            from Spotify, the store that distributes them or a mirror. Files it captured are checked against their
            publisher’s signature; the others say they are not checked yet.
          </p>
        </div>
        <nav class="site-footer__cols" aria-label="Footer">
          <div>
            <h2>Archive</h2>
            <a href="/versions">Versions</a>
            <a href="/probes">Probes</a>
            <a href="/about">How it works</a>
          </div>
          <div>
            <h2>Data</h2>
            <a href="/api">API reference</a>
            <a href="/api/v2/releases">Releases JSON</a>
            <a href="/api/v2/latest">Latest JSON</a>
          </div>
          <div>
            <h2>Project</h2>
            <a href="https://github.com/RobyRew/spotify-versions-history">Source</a>
            <a href="https://github.com/RobyRew/spotify-versions-history/issues">Report a problem</a>
          </div>
        </nav>
      </div>
      <p class="site-footer__base">© {year} RobyRew</p>
    </footer>
    <script>
      import '../scripts/transitions.ts';
    </script>
  </body>
</html>

<style>
  .account {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .account__me {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.55rem 0.2rem 0.2rem;
    border-radius: 999px;
    color: var(--g-ink, var(--ink));
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }
  .account__me:hover {
    background: var(--g-fill, var(--rw-fill));
  }
  .account__out {
    margin: 0;
  }
  @media (max-width: 520px) {
    .account__handle {
      display: none;
    }
  }
  .site-footer {
    border-top: 1px solid var(--hair);
    background: var(--ground-2);
    color: var(--ink-3);
    font-size: 0.86rem;
  }
  .site-footer__inner {
    display: grid;
    gap: 1.6rem 3rem;
    max-width: var(--site-max);
    margin-inline: auto;
    padding: 2rem var(--gutter) 1.2rem;
  }
  @media (min-width: 860px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }
  .site-footer__about p {
    max-width: 36rem;
    margin: 0;
    line-height: 1.55;
  }
  .site-footer__about .site-footer__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    color: var(--ink);
    font-weight: 650;
    font-size: 0.95rem;
  }
  .site-footer__name span {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .site-footer__cols div {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .site-footer__cols h2 {
    margin: 0 0 0.15rem;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .site-footer__cols a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .site-footer__cols a:hover {
    color: var(--accent);
  }
  .site-footer__base {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 0.9rem var(--gutter) calc(1.2rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--hair-soft);
    font-size: 0.8rem;
  }
</style>
