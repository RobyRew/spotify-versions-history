  "type": "module",
  "version": "2.0.0-alpha.0",
  "description": "Archive of official Spotify client builds: ledger, sensors and feeds.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
